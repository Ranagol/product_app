{% extends 'base.html.twig' %}

{% block title %}Homepage Symfony{% endblock %}

{% block body %}

<h1>This is the Home page</h1>

<div>
    {% if app.user %}
        <p>Welcome, {{ app.user.name }}!</p>
    {% else %}
        <p>Please log in or register.</p>
        <a href="{{ path('app_register') }}">Register</a> or
        <a href="{{ path('app_login') }}">Login</a>
    {% endif %}
</div>

<p>Navigate to other sections:</p>
<a href="{{ path('product_index') }}">Go to Product</a>

{# We only want to show the category link to users with ROLE_USER #}
{% if is_granted('ROLE_USER') %}
    <a href="{{ path('app_category_index') }}">Go to Category</a>
{% endif %}

{# We only want to show the admin link to users with ROLE_ADMIN #}
{% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('admin') }}">Go to Admin panel</a>
{% endif %}


{% endblock %}
