{{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.description) }}
    {{ form_row(form.size) }}
    <div>
        <label>
            {{ form_widget(form.is_available) }}
            {{ form_label(form.is_available) }}
        </label>
        {{ form_errors(form.is_available) }}

    </div>

    {# Categories are displayed as checkboxes #}
    {{ form_row(form.categories) }}

    {# Submit button for saving the product #}
    {{ form_row(form.save, {'label': button_label|default('Save Product')}) }}

{{ form_end(form) }}
